# ==========================================
# Git Ignore - Sistema Gym Architect (PHP MVC)
# ==========================================

# --- Base de Datos Local / Runtime ---
database/*.sqlite
database/*.sqlite3
database/*.db
*.sqlite
*.sqlite3
*.db

# --- Archivos de Entorno y Configuración Local ---
.env
.env.local
.env.*.local
config.local.php

# --- Dependencias y Paquetes (Composer / Node) ---
vendor/
composer.phar
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Registros del Sistema y Caché ---
*.log
logs/
temp/
tmp/
cache/

# --- Archivos del Sistema Operativo ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# --- Editores e IDEs ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PhpStorm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# --- Enterprise Architect y Archivos Temporales ---
~$*
*.ldb
*.lock
*.eap.lock
*.qea.lock

# --- Carpeta de Referencia y Material de Apoyo ---
carpeta de referencia/

# --- Scripts Locales de Conveniencia ---
iniciar_servidor.bat
*.bat
